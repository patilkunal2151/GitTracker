<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Gradient: Deep Modern Blue -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#0969DA"/>
                <item android:offset="1" android:color="#054EAA"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Android 17 style 'Blur' Blobs (Ambient Mesh) -->
    <path android:pathData="M27,27m-50,0a50,50 0 1,1 100,0a50,50 0 1,1 -100,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="27"
                android:centerY="27"
                android:gradientRadius="50"
                android:type="radial">
                <item android:offset="0" android:color="#40FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M81,81m-50,0a50,50 0 1,1 100,0a50,50 0 1,1 -100,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="81"
                android:centerY="81"
                android:gradientRadius="50"
                android:type="radial">
                <item android:offset="0" android:color="#20000000"/>
                <item android:offset="1" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- iOS Glassmorphism "Frost" Overlay with Gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#1AFFFFFF"/>
                <item android:offset="1" android:color="#05FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
